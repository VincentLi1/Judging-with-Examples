      "relative_path": "main-header.h",
      "content": "#ifndef __main_header_h__\n#define __main_header_h__\n\n#define MAX_THREADS (100)\n\nint loops = 1;\nint verbose = 0;\nint num_threads = 2;\nint do_timing = 0;\nint cause_deadlock = 0;\nint enable_parallelism = 0;\n\n#endif // __main_header_h__\n"
    },
