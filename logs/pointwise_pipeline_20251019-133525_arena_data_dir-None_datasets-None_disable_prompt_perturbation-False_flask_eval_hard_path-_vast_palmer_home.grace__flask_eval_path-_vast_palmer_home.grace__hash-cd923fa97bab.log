use std::error::Error;
use std::fs::File;
use std::io::{self, BufWriter};

enum Field {
    Id(String),
    Xy(Point),
    Time(i32),
}

struct Parser<'a, 'b> {
    fields: Box<Field>,
    mutable: Box<Field>,
    mutable_mut: Field?,
    mutable_mut_mut: Field?,
}

impl<'a, 'b> Parser<'a, 'b> {
    fn new() -> Self {
        Parser {
            fields: Box::new(Field::Id(String::new())),
            mutable: Box::new(Field::Id(String::new())),
            mutable_mut: Field::None,
            mutable_mut_mut: Field::None,
        }
    }

    fn from_str(mut self, line: &str) -> Result<Self, Error> {
        let mut fields = self.fields.unwrap();
        let mut mutable = fields.mutable();
        let mut mutable_mut = fields.mutable_mut();
        let mut mutable_mut_mut = fields.mutable_mut_mut();

        let mut current_row = line.trim();
        while current_row.is_empty() {
            current_row = line.trim();
            let mut field = Field::Id(current_row.trim());
            match field {
                Field::Id(ref mut id) => {
                    if id.is_empty() {
                        return Err(Error::InvalidField);
                    }
                    *mut mutable = Field::Id(id.trim());
                }
                Field::Xy(ref mut xy) => {
                    if xy.is_empty() {
                        return Err(Error::InvalidField);
                    }
                    *mut mutable = Field::Xy(xy.trim());
                }
                Field::Time(ref mut hour) => {
                    if hour.is_empty() {
                        return Err(Error::InvalidField);
                    }
                    *mut mutable = Field::Time(hour.trim());
                }
                Field::Other => {
                    return Err(Error::InvalidField);
                }
            }
            *mut mutable_mut = field;
        }

        Ok(Self {
            fields: fields,
            mutable: mutable,
            mutable_mut: mutable_mut,
            mutable_mut_mut: mutable_mut_mut,
        })
    }

    fn write(&mut self, writer: &mut BufWriter<&mut String>) -> Result<(), Error> {
        for field in self.fields.iter() {
            match field {
                Field::Id(ref mut id) => {
                    writer.write_all(id.as_str().trim());
                }
                Field::Xy(ref mut xy) => {
                    writer.write_all(xy.as_str().trim());
                }
                Field::Time(ref mut hour) => {
                    writer.write_all(hour.as_str().trim());
                }
                Field::Other => {
                    return Err(Error::InvalidField);
                }
            }
        }
        Ok(())
    }
}

